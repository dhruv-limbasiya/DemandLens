# ==============================================================================
# DemandLens - Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   copy .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Data Paths
DATA_DIR=./data
BRONZE_DATA_PATH=./data/bronze
SILVER_DATA_PATH=./data/silver
GOLD_DATA_PATH=./data/gold

# Apache Spark Local Configuration
SPARK_APP_NAME=DemandLensLocal
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g

# PostgreSQL & pgvector (Future Phase)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=demandlens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# OpenAI API (Future Phase - RAG & Assistant)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# AWS S3 Cloud Storage (Future Phase)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=demandlens-data-lake

