# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking & linting
.mypy_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Data directories and datasets (preserve folder structure via .gitkeep)
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
*.parquet
*.csv
*.tsv
*.jsonl
*.zip
*.tar.gz

# Apache Spark & Hadoop artifacts
hadoop/
spark-warehouse/
metastore_db/
derby.log
checkpoint/
*.checkpoint

# OS artifacts
desktop.ini
Thumbs.db
.DS_Store

# IDE and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

